# Copia in /etc/cup-bot.env (chmod 600) e compila. Non mettere mai il file compilato nel repository.

# token di @BotFather
TELEGRAM_BOT_TOKEN=
# chiave di cifratura del database: python3 store.py genkey
# conservala anche altrove: senza, il database non si puo' piu' leggere
CUP_BOT_KEY=
DB_PATH=/var/lib/cup-bot/cup.db

# come contattare chi gestisce il bot (email o @username): compare nell'informativa. Consigliata.
CONTATTO_GESTORE=

# facoltative
# chat id Telegram PRIVATA di chi gestisce il bot: riceve gli errori imprevisti (senza dati degli utenti)
ADMIN_CHAT_ID=
MAX_UTENTI=30
# ricette seguite al massimo da una stessa chat (la propria, familiari...)
MAX_PRATICHE=0
# minimo 30: ogni controllo tiene bloccata una data per ~40 minuti
INTERVALLO_MIN=45
# solo per ADMIN_CHAT_ID (minimo 5). Vale per una persona sola: ogni controllo blocca una data per ~40 minuti
ADMIN_INTERVALLO_MIN=
DISTANZA_PORTALE_S=20
# 1 = i pulsanti si fermano al riepilogo senza confermare
MODALITA_PROVA=0

# Mini App (facoltativa): indirizzo HTTPS pubblico, servito dal reverse proxy verso 127.0.0.1:WEBAPP_PORTA
WEBAPP_URL=
WEBAPP_PORTA=8095
