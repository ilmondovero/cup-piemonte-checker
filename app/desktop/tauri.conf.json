{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUP Piemonte",
  "version": "0.1.0",
  "identifier": "io.github.ilmondovero.cup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CUP Piemonte",
        "width": 460,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Cerca date prima per le visite prenotate sul CUP Piemonte",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Italian"]
      },
      "wix": {
        "language": "it-IT"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
