{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUP Piemonte",
  "version": "0.3.0",
  "identifier": "io.github.ilmondovero.cup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CUP Piemonte",
        "width": 460,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Cerca date prima per le visite prenotate sul CUP Piemonte",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Italian"
        ]
      },
      "wix": {
        "language": "it-IT"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNEJGMzFGQTAyOEMzMkIKUldRcnd5aWdIL05MMzdYWnczWFA3MVBmUUE2QUpxTS9kdDltcUhvQis5QUJyU05UNFIxYnRZQWkK",
      "endpoints": [
        "https://github.com/ilmondovero/cup-piemonte-checker/releases/download/aggiornamenti/latest.json",
        "https://ilmondovero.github.io/cup-piemonte-checker/aggiornamenti/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
